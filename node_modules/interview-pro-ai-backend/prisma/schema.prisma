generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String?
  googleId     String?       @unique
  fullName     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      Profile?
  resumes      Resume[]
  interviews   Interview[]
  settings     UserSettings?
  codingTests  CodingTest[]
}

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone        String?
  location     String?
  headline     String?
  bio          String?
  photoUrl     String?
  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?
  skills       String?  // JSON string array
  education    String?  // JSON string
  experience   String?  // JSON string
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Resume {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName    String
  fileType    String
  fileSize    Int
  filePath    String
  rawText     String
  isParsed    Boolean            @default(false)
  parsedAt    DateTime?
  candidateName String?
  email       String?
  phone       String?
  summary     String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  skills      ResumeSkill[]
  projects    ResumeProject[]
  experiences ResumeExperience[]
  educations  ResumeEducation[]
  interviews  Interview[]
}

model ResumeSkill {
  id        String   @id @default(uuid())
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name      String
  category  String?  // e.g. Technical, Soft, Language
  level     String?  // Beginner, Intermediate, Expert
}

model ResumeProject {
  id           String   @id @default(uuid())
  resumeId     String
  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  technologies String?  // JSON string array
  link         String?
}

model ResumeExperience {
  id               String   @id @default(uuid())
  resumeId         String
  resume           Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  company          String
  role             String
  duration         String?
  responsibilities String?  // JSON string array
}

model ResumeEducation {
  id          String   @id @default(uuid())
  resumeId    String
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  degree      String
  institution String
  year        String?
  details     String?
}

model Interview {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId      String?
  resume        Resume?             @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  title         String
  type          String              // Technical, HR, Behavioral, Project, Mixed
  difficulty    String              // Easy, Medium, Hard
  totalQuestions Int                @default(5)
  mode          String              // Text, Voice, VoiceText
  status        String              // pending, in_progress, completed
  overallScore  Float               @default(0)
  durationSec   Int                 @default(0)
  createdAt     DateTime            @default(now())
  completedAt   DateTime?
  settings      String?             // JSON string for options like enableFollowUps, etc.
  questions     InterviewQuestion[]
  evaluations   InterviewEvaluation[]
}

model InterviewQuestion {
  id              String             @id @default(uuid())
  interviewId     String
  interview       Interview          @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  orderIndex      Int
  questionText    String
  category        String?
  isFollowUp      Boolean            @default(false)
  parentQuestionId String?
  answer          InterviewAnswer?
}

model InterviewAnswer {
  id           String             @id @default(uuid())
  questionId   String             @unique
  question     InterviewQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText   String
  inputMethod  String             @default("text") // text or voice
  durationSec  Int                @default(0)
  createdAt    DateTime           @default(now())
  evaluation   InterviewEvaluation?
}

model InterviewEvaluation {
  id                 String           @id @default(uuid())
  interviewId        String
  interview          Interview        @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  answerId           String?          @unique
  answer             InterviewAnswer? @relation(fields: [answerId], references: [id], onDelete: Cascade)
  technicalScore     Float            @default(0)
  communicationScore Float            @default(0)
  relevanceScore     Float            @default(0)
  confidenceScore    Float            @default(0)
  qualityScore       Float            @default(0)
  overallScore       Float            @default(0)
  strengths          String           // JSON string array
  improvements       String           // JSON string array
  feedback           String
  createdAt          DateTime         @default(now())
}

model UserSettings {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultInterviewType   String   @default("Technical")
  defaultDifficulty      String   @default("Medium")
  defaultQuestionCount   Int      @default(5)
  defaultMode            String   @default("VoiceText")
  ttsVoice               String   @default("default")
  ttsSpeed               Float    @default(1.0)
  emailReminders         Boolean  @default(true)
  performanceReports     Boolean  @default(true)
  updatedAt              DateTime @updatedAt
}

model CodingTest {
  id              String               @id @default(uuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  language        String               // Python, Java, JavaScript, C, C++
  difficulty      String               // Beginner, Intermediate, Advanced
  totalQuestions  Int                  @default(5)
  durationMinutes Int                  @default(30)
  status          String               @default("in_progress") // in_progress, completed
  score           Float                @default(0)
  accuracy        Float                @default(0)
  timeTakenSec    Int                  @default(0)
  strengths       String?              // JSON string
  improvements    String?              // JSON string
  aiFeedback      String?
  createdAt       DateTime             @default(now())
  completedAt     DateTime?
  questions       CodingTestQuestion[]
  submissions     CodingSubmission[]
}

model CodingTestQuestion {
  id             String             @id @default(uuid())
  testId         String
  test           CodingTest         @relation(fields: [testId], references: [id], onDelete: Cascade)
  orderIndex     Int
  title          String
  description    String
  inputFormat    String?
  outputFormat   String?
  constraints    String?
  exampleInput   String?
  exampleOutput  String?
  starterCode    String?            // JSON string mapping language to template
  solutionCode   String?            // JSON string mapping language to official solution
  testCases      String             // JSON array of { input, expectedOutput, isHidden }
  submissions    CodingSubmission[]
}

model CodingSubmission {
  id               String             @id @default(uuid())
  testId           String
  test             CodingTest         @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId       String
  question         CodingTestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  code             String
  language         String
  status           String             // passed, failed, error
  passedTestCases  Int                @default(0)
  totalTestCases   Int                @default(0)
  stdout           String?
  executionTimeMs  Int                @default(0)
  createdAt        DateTime           @default(now())
}

